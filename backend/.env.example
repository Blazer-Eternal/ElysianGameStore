# ---- Server ----
PORT=5000
ENVIRONMENT=development

# ---- Database (PostgreSQL) ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=ElysianGameStore
DB_DIALECT=postgres

# ---- Auth ----
JWT_SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# ---- CORS (comma-separated browser origins; unset = dev defaults) ----
CLIENT_URL=http://localhost:3000

# ---- Rate limits ----
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=30
LOGIN_RATE_LIMIT_MAX=10
SENSITIVE_RATE_LIMIT_MAX=10

# ---- Payments (provider-agnostic stub layer) ----
# mock = signed stub adapters for ESEWA/KHALTI/CONNECTIPS/IMEPAY (sandbox-ready)
PAYMENT_PROVIDER_MODE=mock
# Shared secret used to HMAC webhook payloads (x-elysian-signature header)
WEBHOOK_SECRET=change-me-webhook-secret
# Where the stub "checkout page" points the browser after paying
MOCK_PAYMENT_BASE_URL=http://localhost:5000/api/orders
# Dev-only shortcut that simulates a provider callback without a real wallet
ENABLE_MOCK_PAYMENTS=true

# ---- CDN / signed download URLs ----
CDN_BASE_URL=http://localhost:9000/elysian-builds
CDN_SIGNING_SECRET=change-me-cdn-secret
CDN_SIGN_TTL_SEC=300

# ---- Commerce rules (NPR) ----
REFUND_WINDOW_DAYS=14
REFUND_PLAYTIME_MINUTES=120
PENDING_ORDER_TTL_HOURS=24
PAYOUT_HOLD_DAYS=30
# Stub FX snapshot rate for USD payouts (NPR per 1 USD)
FX_RATE_USD_NPR=133.50

# ---- Maintenance sweep interval (ms) ----
SWEEP_INTERVAL_MS=60000
